# Shared environment for all Kairos services (docker compose env_file).
KAIROS_ENVIRONMENT=prod
KAIROS_LOG_LEVEL=INFO
KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://redis:6379/0

# LLM
KAIROS_OPENAI_API_KEY=sk-...

# Execution (DRY-RUN by default — flip to false only when you mean it)
KAIROS_EXCHANGE=evedex
KAIROS_DRY_RUN=true
KAIROS_EVEDEX_EXCHANGE_URL=https://exchange-api.evedex.com
KAIROS_EVEDEX_CHAIN_ID=1
KAIROS_EVEDEX_PRIVATE_KEY=
