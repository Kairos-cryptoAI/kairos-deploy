# Compose interpolation inventory. Copy to `.env`, keep `.env` untracked, and
# replace every `replace-with-*` value before a production start. Compose passes
# each key only to the service that owns it; this file is never used as env_file.

# Shared non-secret runtime configuration
KAIROS_ENVIRONMENT=prod
KAIROS_LOG_LEVEL=INFO
KAIROS_LOG_JSON=true
KAIROS_TRADING_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT"]

# Infrastructure secrets. Generate independent values; Redis must remain URL-safe.
# Example generator for each password: openssl rand -hex 32
KAIROS_REDIS_PASSWORD=replace-with-64-char-hex-redis-password
POSTGRES_USER=kairos
POSTGRES_PASSWORD=replace-with-independent-postgres-password
POSTGRES_DB=kairos
GRAFANA_ADMIN_USER=kairos-admin
GRAFANA_ADMIN_PASSWORD=replace-with-independent-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Text Scouts owns the optional source credentials below.
KAIROS_BRIGHTDATA_API_TOKEN=
KAIROS_BRIGHTDATA_X_DATASET_ID=
KAIROS_REDDIT_CLIENT_ID=
KAIROS_REDDIT_CLIENT_SECRET=
KAIROS_REDDIT_USER_AGENT=kairos-text-scouts/0.1 by Kairos-cryptoAI

# LLM credentials are allow-listed only to callers that use each provider.
KAIROS_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
KAIROS_OPENAI_API_KEY=replace-with-openai-api-key

# Execution-only settings. The Compose deployment requires both EVEDEX secrets,
# even in dry-run, so a later live-mode switch cannot start with missing auth.
KAIROS_DRY_RUN=true
KAIROS_ACCOUNT_ID=primary
KAIROS_ACCOUNT_SNAPSHOT_INTERVAL_S=15
KAIROS_DRY_RUN_EQUITY_USD=10000
KAIROS_EVEDEX_EXCHANGE_URL=https://exchange-api.evedex.com
KAIROS_EVEDEX_CHAIN_ID=1
KAIROS_EVEDEX_JWT=replace-with-evedex-jwt
KAIROS_EVEDEX_PRIVATE_KEY=replace-with-0x-prefixed-64-hex-private-key

# Risk remains fail-closed. The Compose file hard-codes reconciliation/allocation
# requirements to true; only the freshness window is configurable here.
KAIROS_ACCOUNT_SNAPSHOT_MAX_AGE_S=60
