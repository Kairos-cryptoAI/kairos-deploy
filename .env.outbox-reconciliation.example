# This is topology-only input. It must never contain a credential.
# The operational wrapper requires explicit paths and creates no secret files.
KAIROS_OFFLINE_OUTBOX_SECRETS_DIR=./secrets-offline-outbox-DO-NOT-CREATE
KAIROS_OFFLINE_OUTBOX_INPUT_DIR=./offline-outbox-input-DO-NOT-CREATE
KAIROS_OFFLINE_OUTBOX_DATA_NETWORK=offline-outbox-data-network-MUST-BE-SUPPLIED
KAIROS_OFFLINE_OUTBOX_BUS_NETWORK=offline-outbox-bus-network-MUST-BE-SUPPLIED
